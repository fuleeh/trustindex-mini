<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="Read and share trusted company reviews.">
        <title>{% block title %}Trustindex Reviews{% endblock %}</title>
        <link rel="stylesheet" href="/styles/app.css">
    </head>
    <body>
        <header class="site-header">
            <nav class="container nav" aria-label="Main navigation">
                <a class="brand" href="{{ path('review_index') }}">Trustindex Reviews</a>
                <div class="nav-links">
                    <a href="{{ path('review_index') }}">Reviews</a>
                    <a href="{{ path('review_companies') }}">Companies</a>
                    <a href="{{ path('review_search') }}">Search</a>
                </div>
            </nav>
        </header>
        <main class="container page-content">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type }}" role="status">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
        <footer class="site-footer"><div class="container">Company reviews, kept simple.</div></footer>
    </body>
</html>
