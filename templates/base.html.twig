<!DOCTYPE html>
<html lang="hu">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="description" content="Olvass és ossz meg hiteles cégértékeléseket.">
        <title>{% block title %}Trustindex-mini{% endblock %}</title>
        <link rel="stylesheet" href="/styles/app.css?v=3">
    </head>
    <body>
        <header class="site-header">
            <nav class="container nav" aria-label="Fő navigáció">
                <a class="brand" href="{{ path('review_index') }}">Trustindex-mini</a>
                <div class="nav-links">
                    <a href="{{ path('review_index') }}">Vélemények</a>
                    <a href="{{ path('review_companies') }}">Cégek</a>
                    <a href="{{ path('review_search') }}">Keresés</a>
                </div>
            </nav>
        </header>
        <main class="container page-content">
            {% for type, messages in app.flashes %}
                {% for message in messages %}
                    <div class="alert alert-{{ type }}" role="status">{{ message }}</div>
                {% endfor %}
            {% endfor %}
            {% block body %}{% endblock %}
        </main>
        <footer class="site-footer"><div class="container"><span class="footer-mark">Trustindex-mini</span><span>Cégértékelések egyszerűen.</span></div></footer>
    </body>
</html>
