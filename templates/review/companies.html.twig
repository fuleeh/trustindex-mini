{% extends 'base.html.twig' %}

{% block title %}Cégek rangsora · Trustindex-mini{% endblock %}

{% block body %}
    <section class="page-heading inner-hero">
        <p class="eyebrow">// gyors áttekintés</p>
        <h1>Cégek rangsora</h1>
        <p class="lead">Cégek az átlagos ügyfélértékelésük szerint rendezve.</p>
    </section>
    <div class="card table-card"><div class="table-scroll"><table>
        <thead><tr><th scope="col">Cég</th><th scope="col">Vélemények</th><th scope="col">Átlagos értékelés</th></tr></thead>
        <tbody>
            {% for company in companies %}
                <tr>
                    <th scope="row">{{ company.companyName }}</th>
                    <td>{{ company.reviewCount }}</td>
                    <td>
                        {% include 'review/_stars.html.twig' with {rating: company.averageRating|round} only %}
                        <span class="rating-number">{{ company.averageRating|number_format(2) }}</span>
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="3">Még nem érhető el cégstatisztika.</td></tr>
            {% endfor %}
        </tbody>
    </table></div></div>
{% endblock %}
