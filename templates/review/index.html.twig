{% extends 'base.html.twig' %}

{% block title %}Trustindex-mini · Cégértékelések{% endblock %}

{% block body %}
    <section class="hero">
        <p class="eyebrow">// közösségi cégértékelések</p>
        <h1>Valódi tapasztalatok.<br>Jobb döntések.</h1>
        <p class="lead">Olvasd el mások tapasztalatait, vagy oszd meg a sajátodat egy cégről.</p>
        <div class="hero-actions">
            <a class="button" href="#review-form-heading">Írj véleményt</a>
            <a class="button button-secondary" href="{{ path('review_companies') }}">Cégstatisztikák</a>
        </div>
    </section>

    <div class="content-grid">
        <section aria-labelledby="reviews-heading">
            <div class="section-heading">
                <div><p class="eyebrow">// {{ reviews|length }} vélemény</p><h2 id="reviews-heading">Legújabb vélemények</h2></div>
                <a class="text-link" href="{{ path('review_search') }}">Vélemények keresése</a>
            </div>
            <div class="card-list">
                {% for review in reviews %}
                    {% include 'review/_review_card.html.twig' with {review: review} only %}
                {% else %}
                    <div class="empty-state">Még nincs vélemény. Oszd meg elsőként a tapasztalatodat!</div>
                {% endfor %}
            </div>
        </section>

        <aside class="card form-card" aria-labelledby="review-form-heading">
            <p class="eyebrow">// mondd el a véleményed</p>
            <h2 id="review-form-heading">Írj véleményt</h2>
            {{ form_start(reviewForm) }}
                {{ form_row(reviewForm.companyName) }}
                {{ form_row(reviewForm.rating) }}
                {{ form_row(reviewForm.reviewText) }}
                {{ form_row(reviewForm.authorEmail) }}
                {{ form_row(reviewForm.website) }}
                <button class="button" type="submit">Vélemény beküldése</button>
            {{ form_end(reviewForm) }}
        </aside>
    </div>
{% endblock %}
