{% extends 'base.html.twig' %}

{% block title %}Vélemények keresése · Trustindex-mini{% endblock %}

{% block body %}
    <section class="page-heading inner-hero">
        <p class="eyebrow">// cég keresése</p>
        <h1>Vélemények keresése</h1>
        <form class="search-form" action="{{ path('review_search') }}" method="get" role="search">
            <label class="sr-only" for="company-search">Cégnév</label>
            <input id="company-search" type="search" name="q" value="{{ query }}" maxlength="255" placeholder="Keresés cégnév alapján" required>
            <button class="button" type="submit">Keresés</button>
        </form>
    </section>
    {% if query %}
        <div class="section-heading"><h2>Találatok erre: „{{ query }}”</h2><span>{{ reviews|length }} találat</span></div>
        <div class="card-list">
            {% for review in reviews %}
                {% include 'review/_review_card.html.twig' with {review: review} only %}
            {% else %}
                <div class="empty-state">Nem található vélemény ezzel a cégnévvel.</div>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}
